{
  "name": "pet-checkin",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "mock-api": "esbuild tools/mock-api.ts --bundle --platform=node --format=cjs --outfile=tools/mock-api.build.cjs --log-level=error && node tools/mock-api.build.cjs",
    "audit-math": "esbuild tools/audit-math.ts --bundle --platform=node --format=cjs --outfile=tools/audit-math.build.cjs --log-level=error && node tools/audit-math.build.cjs",
    "rename-fc": "esbuild tools/rename-fc-images.ts --bundle --platform=node --format=cjs --outfile=tools/rename-fc-images.build.cjs --log-level=error && node tools/rename-fc-images.build.cjs && node -e \"require('fs').rmSync('tools/rename-fc-images.build.cjs',{force:true})\"",
    "words": "esbuild tools/dump-english-words.ts --bundle --platform=node --format=cjs --outfile=tools/dump-english-words.build.cjs --log-level=error && node tools/dump-english-words.build.cjs",
    "smoke": "esbuild smoke.ts --bundle --platform=node --format=cjs --outfile=smoke.build.cjs --log-level=error && node -r ./smoke-shim.cjs smoke.build.cjs && node -e \"require('fs').rmSync('smoke.build.cjs',{force:true})\"",
    "verify": "npm run typecheck && npm run smoke && npm run build"
  },
  "dependencies": {
    "msedge-tts": "^2.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.21.5",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^2.0.0"
  }
}
