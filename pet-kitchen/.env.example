# ============================================================================
# 复制成 .env 后生效（.env 不进版本库）
# ============================================================================

# 后端地址。留空 = 纯本地模式：题库全部本地程序化生成，零网络、零成本、零延迟。
#
# 配了地址才会走远端出题与批改，例如部署到轻量服务器之后：
#   VITE_API_BASE_URL=http://123.45.67.89:8787
#
# 远端不可用时会自动回落到本地出题，孩子那边不会玩不了，
# 只是界面上会显示一条「连不上服务器，已用本地题目」。
#
# 本地验证 HTTP 契约：另开一个终端跑 `npm run mock-api`（默认 8787 端口），
# 然后把下面这行打开即可。
# VITE_API_BASE_URL=http://127.0.0.1:8787
VITE_API_BASE_URL=

# 出题是否优先走远端。默认「配了地址就走远端」，设 0 可强制纯本地出题
# （零延迟、零成本），此时仍可用下面的 VITE_SYNC_URL 单独开启同步。
# VITE_PREFER_REMOTE=0

# ============================================================================
# 数据同步令牌（对应服务器环境变量 SYNC_TOKEN）
#
# 与上面的 VITE_API_BASE_URL **同时存在**才开启同步；缺任一个 = 纯本地模式，
# 一行不写、一个请求不发，行为与接线之前完全一致。
#
# 开启后：打卡流水 / 每日快照 / 关卡进度 / 错题 / 答题明细 会先攒在本地队列里
#（localStorage），再批量推到 POST /api/sync。op_id 幂等，重推不会写重；
# 断网只会「先攒着」，绝不阻塞孩子玩。
#
# ⚠️ VITE_ 前缀的变量会被打进前端 bundle，这个令牌等同「半公开」的写入凭证。
#    所以它只够写 /api/sync；能读全量数据的 /api/report 刻意不开放给前端。
#    生产环境请务必：① nginx 同域反代（顺带避开 CORS）、② 给 /api/sync 限流。
VITE_SYNC_TOKEN=

# 同步接口地址。不填就复用 VITE_API_BASE_URL。
# 同域部署（nginx 反代）时填域名即可，例如 https://petkitchen.com
# VITE_SYNC_URL=

# ============================================================================
# 后端服务端环境变量（/opt/pet-checkin/env/pet-checkin.env，只放服务器上）：
#   PORT=8787
#   TCB_ENV_ID=base-xxxx
#   TCB_API_KEY=<CloudBase 控制台创建的 API Key，绝不进前端仓库>
#   SYNC_TOKEN=<sync/report 接口的访问令牌>
# ============================================================================

# ============================================================================
# 讯飞语音评测（英语「课本 · 跟读评分」用；对应后端 POST /api/score）
#
# ⚠️ 这几项是**服务端**变量，绝对不要加 VITE_ 前缀 ——
#    加了就会被打进前端 bundle，等于把讯飞额度送人刷。
#    讯飞官方也明确「不支持跨域，请在后端调用」。
#
# 两种放法，任选其一：
#   ① 环境变量（推荐，密钥不落盘）：就填在下面
#   ② 本地文件：复制 server/xfyun.config.json.example → server/xfyun.config.json 再填
#      （该文件已在 .gitignore 里，不会进仓库）
#
# 没配也能跑：跟读关会提示「后端未配置评分密钥」，
# 其它四个版块（拼音 / 数学 / 识字 / 综合）完全不受影响。
# 自查：GET /api/score/health 会回显 credentials_ready 与密钥来源。
# XFYUN_APP_ID=
# XFYUN_API_KEY=
# XFYUN_API_SECRET=
# 打分门限（可选）：hard / common / easy，缺省 common
# XFYUN_CHECK_TYPE=common
# ============================================================================
